# ---- General ----
PORT=3000
# Public HTTPS URL of this server (WhatsApp webhook + OAuth redirects need it)
BASE_URL=https://your-domain.example
TIMEZONE=Asia/Kuala_Lumpur
# Hour (0-23, local) for the daily WhatsApp digest
DIGEST_HOUR=8
# Set to 1 to simulate everything (no real API calls, no keys needed)
DRY_RUN=0

# ---- People ----
# Names of the account owners (used in commands, e.g. "stats hazmi")
OWNERS=hazmi,wife
# WhatsApp numbers (digits only, with country code) allowed to control the bot: number:owner
WA_ALLOWED=60123456789:hazmi,60129876543:wife
# true = either of you can manage the other's accounts; false = own accounts only (stats/plan stay shared)
CROSS_ACCESS=true

# ---- WhatsApp Cloud API (Meta) ----
WA_TOKEN=
WA_PHONE_ID=
WA_VERIFY_TOKEN=pick-any-random-string
WA_APP_SECRET=
# Optional approved template (one body variable {{1}}) used when the 24h chat window is closed
WA_TEMPLATE_NAME=
WA_TEMPLATE_LANG=en

# ---- Threads API (Meta) ----
THREADS_APP_ID=
THREADS_APP_SECRET=

# ---- TikTok for Developers ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Unaudited TikTok apps can only post as SELF_ONLY. Use PUBLIC_TO_EVERYONE after audit approval.
TIKTOK_PRIVACY=SELF_ONLY

# ---- Optional: Claude for ideas + reply drafts ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# ---- Reply automation ----
# Max automatic replies per account per day (only used when "auto on")
AUTO_REPLY_DAILY_CAP=20
